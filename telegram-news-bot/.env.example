# ─── YouKnowTrader News Bot Configuration ───
# Copy this file to .env and fill in the values.

# Telegram Bot Token (required)
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram Channel ID (optional)
# If set, news will also be posted to this channel/group
# Use @channelname or numeric ID (e.g., -1001234567890)
TELEGRAM_CHANNEL_ID=

# Polling interval in seconds (default: 60)
# Lower = faster news, but more API calls
POLL_INTERVAL=60

# Database path (default: news_bot.db)
DB_PATH=news_bot.db

# Target translation language (default: id = Indonesian)
TARGET_LANG=id

# Max news items per fetch per source (default: 5)
MAX_ITEMS_PER_FETCH=5
