    bool showTrace = false
    if htf_settings.trace_anchor == 'First Timeframe' and cnt == 0
        showTrace := true
    if htf_settings.trace_anchor == 'Last Timeframe' and cnt == last - 1
        showTrace := true
    htf2.UpdateTime(htf_offset)
    htf2.Monitor().Update(htf_offset, showTrace).FindImbalance().DetectSwings()
    cnt := cnt + 1
    htf_offset := htf_offset + (cnt > 0 ? htf2.candles.size() * htf_settings.width + (htf2.candles.size() > 0 ? (htf2.candles.size() - 1) * htf_settings.buffer : 0) + htf_settings.htf_buffer : 0)

