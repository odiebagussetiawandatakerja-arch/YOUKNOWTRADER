htf_settings.width              := input.int(1, 'Candle Width', minval = 1, maxval = 4, group=group_style) * 2

string group_label              = "HTF Labels  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
htf_settings.htf_label_show     := input.bool(true, 'HTF Label           ', group=group_label, inline = 'HTFlabel')
htf_settings.htf_label_color    := input.color(color.new(#0f0f0f, 10), '', group=group_label, inline = 'HTFlabel')
htf_settings.htf_label_size     := input.string(size.normal, '', [size.tiny, size.small, size.normal, size.large, size.huge], group=group_label, inline = 'HTFlabel')
htf_label_bold                  = input.bool(false, title="Bold", group=group_label, inline="HTFlabel")

htf_settings.label_position     := input.string("Top", 'Label Positions', options=['Both', 'Top', 'Bottom'], group=group_label)
htf_settings.label_alignment    := input.string("Follow Candles", "Label Alignment", options=['Align', 'Follow Candles'], group=group_label)

