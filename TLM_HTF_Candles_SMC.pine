htf_settings.htf_timer_color    := input.color(color.new(#0f0f0f, 10), '', inline = 'timer', group=group_label)
htf_settings.htf_timer_size     := input.string(size.small, '', [size.tiny, size.small, size.normal, size.large, size.huge], group=group_label, inline = 'timer')

htf_settings.daily_name         := input.bool(false, 'Candle Time        ', group=group_label, inline = 'dow')
