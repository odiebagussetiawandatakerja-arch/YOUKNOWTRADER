box_transparency  = input.int(70, "Box Transparency", 0, 100, group = g_KZ)
text_transparency = input.int(50, "Text Transparency", 0, 100, group = g_KZ)

var g_KZP = "① Killzones — Pivots"
show_pivots     = input.bool(true, "Show Pivots", inline = "PV", group = g_KZP)
use_alerts      = input.bool(true, "Alert Broken Pivots", inline = "PV", group = g_KZP)
show_midpoints  = input.bool(false, "Show Pivot Midpoints", inline = "mp", group = g_KZP)
stop_midpoints  = input.bool(true, "Stop Once Mitigated", inline = "mp", group = g_KZP)
show_labels     = input.bool(true, "Show Pivot Labels", inline = "LB", group = g_KZP)
label_price     = input.bool(false, "Display Price", inline = "LB", group = g_KZP)
label_right     = input.bool(false, "Right Side", inline = "LB", group = g_KZP)
ext_pivots      = input.string("Until Mitigated", "Extend Pivots...", options = ['Until Mitigated', 'Past Mitigation'], group = g_KZP)
