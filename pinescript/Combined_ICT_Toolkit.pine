show_w_open     = input.bool(false, "W Open", inline = "WO", group = g_DWM)
whl             = input.bool(false, "High/Low", inline = "WO", group = g_DWM)
ws              = input.bool(false, "Separators", inline = "WO", group = g_DWM)
