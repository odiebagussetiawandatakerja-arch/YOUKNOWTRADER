use_h3          = input.bool(false, "", inline = "H3", group = g_OPEN)
h3_text         = input.string("10:00", "", inline = "H3", group = g_OPEN)
h3              = input.session("1000-1001", "", inline = "H3", group = g_OPEN)
h3_color        = input.color(color.black, "", inline = "H3", group = g_OPEN)
