// --- Timestamps ---
var g_VERT = "① Timestamps"
v_unlimited     = input.bool(false, "Unlimited", group = g_VERT)
use_v1          = input.bool(false, "", inline = "V1", group = g_VERT)
v1              = input.session("0000-0001", "", inline = "V1", group = g_VERT)
v1_color        = input.color(color.black, "", inline = "V1", group = g_VERT)
use_v2          = input.bool(false, "", inline = "V2", group = g_VERT)
v2              = input.session("0800-0801", "", inline = "V2", group = g_VERT)
v2_color        = input.color(color.black, "", inline = "V2", group = g_VERT)
vl_style        = get_line_type(input.string('Dotted', "Style", options = ['Solid', 'Dotted', 'Dashed'], inline = "V0", group = g_VERT))
vl_width        = input.int(1, "", inline = "V0", group = g_VERT)

// --- Killzone Types & Variables ---
type kz
    string _title
    array<box> _box
    array<line> _hi_line
    array<line> _md_line
    array<line> _lo_line
    array<label> _hi_label
    array<label> _lo_label
    array<bool> _hi_valid
    array<bool> _md_valid
    array<bool> _lo_valid
    array<float> _range_store
    float _range_current

type hz_type
    array<line> LN
    array<label> LB
    array<bool> CO

type dwm_hl_type
    array<line> hi_line
    array<line> lo_line
    array<label> hi_label
    array<label> lo_label
    bool hit_high = false
    bool hit_low = false

type dwm_info
    string tf
    float o = na
    float h = na
    float l = na
    float ph = na
    float pl = na

type lines_helper
    hz_type _hz
    string h
    string h_text
    color h_color

type kz_helper
    kz _kz
    string session
    color c
    string box_txt
    string hi_txt
    string lo_txt

type ts_helper
    string session
    array<line> lines
    color c

initLines() =>
    array<lines_helper> res = array.new<lines_helper>()
    if use_h1
        res.push(lines_helper.new(hz_type.new(array.new_line(), array.new_label(), array.new_bool()), h1, h1_text, h1_color))
    if use_h2
        res.push(lines_helper.new(hz_type.new(array.new_line(), array.new_label(), array.new_bool()), h2, h2_text, h2_color))
    if use_h3
        res.push(lines_helper.new(hz_type.new(array.new_line(), array.new_label(), array.new_bool()), h3, h3_text, h3_color))
    if use_h4
        res.push(lines_helper.new(hz_type.new(array.new_line(), array.new_label(), array.new_bool()), h4, h4_text, h4_color))
    res

var array<lines_helper> open_lines = initLines()

initKZ() =>
    array<kz_helper> res = array.new<kz_helper>()
    if use_asia
        res.push(kz_helper.new(kz.new(as_txt, array.new_box(), array.new_line(), array.new_line(), array.new_line(), array.new_label(), array.new_label(), array.new_bool(), array.new_bool(), array.new_bool(), array.new_float()), asia, as_color, as_txt, ash_str, asl_str))
    if use_london
        res.push(kz_helper.new(kz.new(lo_txt, array.new_box(), array.new_line(), array.new_line(), array.new_line(), array.new_label(), array.new_label(), array.new_bool(), array.new_bool(), array.new_bool(), array.new_float()), london, lo_color, lo_txt, loh_str, lol_str))
    if use_nyam
        res.push(kz_helper.new(kz.new(na_txt, array.new_box(), array.new_line(), array.new_line(), array.new_line(), array.new_label(), array.new_label(), array.new_bool(), array.new_bool(), array.new_bool(), array.new_float()), nyam, na_color, na_txt, nah_str, nal_str))
    if use_nylu
        res.push(kz_helper.new(kz.new(nl_txt, array.new_box(), array.new_line(), array.new_line(), array.new_line(), array.new_label(), array.new_label(), array.new_bool(), array.new_bool(), array.new_bool(), array.new_float()), nylu, nl_color, nl_txt, nlh_str, nll_str))
    if use_nypm
        res.push(kz_helper.new(kz.new(np_txt, array.new_box(), array.new_line(), array.new_line(), array.new_line(), array.new_label(), array.new_label(), array.new_bool(), array.new_bool(), array.new_bool(), array.new_float()), nypm, np_color, np_txt, nph_str, npl_str))
    res

var array<kz_helper> _kz = initKZ()

var d_hl_data = dwm_hl_type.new(array.new_line(), array.new_line(), array.new_label(), array.new_label())
var w_hl_data = dwm_hl_type.new(array.new_line(), array.new_line(), array.new_label(), array.new_label())
var m_hl_data = dwm_hl_type.new(array.new_line(), array.new_line(), array.new_label(), array.new_label())

var d_info = dwm_info.new("D")
var w_info = dwm_info.new("W")
var m_info = dwm_info.new("M")

t_co = not na(time("", cutoff, gmt_tz))

initTS() =>
    array<ts_helper> res = array.new<ts_helper>()
    if use_v1
        res.push(ts_helper.new(v1, array.new_line(), v1_color))
    if use_v2
        res.push(ts_helper.new(v2, array.new_line(), v2_color))
    res

var array<ts_helper> ts_data = initTS()

var d_sep_line = array.new_line()
var w_sep_line = array.new_line()
var m_sep_line = array.new_line()
var d_line = array.new_line()
var w_line = array.new_line()
var m_line = array.new_line()
var d_label = array.new_label()
var w_label = array.new_label()
var m_label = array.new_label()

var ext_current = ext_which == 'Most Recent'
var ext_past = ext_pivots == 'Past Mitigation'

update_dwm_info(dwm_info n) =>
    if timeframe.change(n.tf)
        n.ph := n.h
        n.pl := n.l
        n.o := open
        n.h := high
        n.l := low
    else
        n.h := math.max(high, n.h)
        n.l := math.min(low, n.l)

if kz_enabled
    if dhl or show_d_open
        update_dwm_info(d_info)
    if whl or show_w_open
        update_dwm_info(w_info)
    if mhl or show_m_open
        update_dwm_info(m_info)

// --- Killzone Core Functions ---
get_box_color(color c) => color.new(c, box_transparency)
get_text_color(color c) => color.new(c, text_transparency)

dwm_sep(string tf, bool use, array<line> arr, color col) =>
    if use
        if timeframe.change(tf)
            arr.unshift(line.new(bar_index, high * 1.0001, bar_index, low, style = htf_style, width = htf_width, extend = extend.both, color = col))
            if not sep_unlimited and arr.size() > max_days
                arr.pop().delete()

dwm_open_fn(string tf, bool use, array<line> lns, array<label> lbls, dwm_info n, color col) =>
    if use
        if lns.size() > 0
            lns.get(0).set_x2(time)
            lbls.get(0).set_x(time)
        if timeframe.change(tf)
            lns.unshift(line.new(time, n.o, time, n.o, xloc = xloc.bar_time, style = htf_style, width = htf_width, color = col))
            lbls.unshift(label.new(time, n.o, tf + " OPEN", xloc = xloc.bar_time, style = label.style_label_left, color = transparent, textcolor = txt_color, size = lbl_size))
            if not sep_unlimited and lns.size() > max_days
                lns.pop().delete()
                lbls.pop().delete()

dwm_hl_fn(string tf, bool use, dwm_hl_type hl, dwm_info n, color col) =>
    if use
        if hl.hi_line.size() > 0
            hl.hi_line.get(0).set_x2(time)
            hl.lo_line.get(0).set_x2(time)
            hl.hi_label.get(0).set_x(time)
            hl.lo_label.get(0).set_x(time)
        if timeframe.change(tf)
            hl.hi_line.unshift(line.new(time, n.ph, time, n.ph, xloc = xloc.bar_time, style = htf_style, width = htf_width, color = col))
            hl.lo_line.unshift(line.new(time, n.pl, time, n.pl, xloc = xloc.bar_time, style = htf_style, width = htf_width, color = col))
            hl.hi_label.unshift(label.new(time, n.ph, "P" + tf + "H", xloc = xloc.bar_time, style = label.style_label_left, color = transparent, textcolor = txt_color, size = lbl_size))
            hl.lo_label.unshift(label.new(time, n.pl, "P" + tf + "L", xloc = xloc.bar_time, style = label.style_label_left, color = transparent, textcolor = txt_color, size = lbl_size))
            hl.hit_high := false
            hl.hit_low := false
            if not sep_unlimited and hl.hi_line.size() > max_days
                hl.hi_line.pop().delete()
                hl.lo_line.pop().delete()
                hl.hi_label.pop().delete()
                hl.lo_label.pop().delete()
        if hl.hi_line.size() > 0 and alert_HL
            if not hl.hit_high and high > hl.hi_line.get(0).get_y1()
                hl.hit_high := true
                alert(str.format("Hit P{0}H", tf))
            if not hl.hit_low and low < hl.lo_line.get(0).get_y1()
                hl.hit_low := true
                alert(str.format("Hit P{0}L", tf))

dwm() =>
    if tf_ok
        dwm_sep("D", ds, d_sep_line, d_color)
        dwm_sep("W", ws, w_sep_line, w_color)
        dwm_sep("M", ms, m_sep_line, m_color)
        dwm_open_fn("D", show_d_open, d_line, d_label, d_info, d_color)
        dwm_open_fn("W", show_w_open, w_line, w_label, w_info, w_color)
        dwm_open_fn("M", show_m_open, m_line, m_label, m_info, m_color)
        dwm_hl_fn("D", dhl, d_hl_data, d_info, d_color)
        dwm_hl_fn("W", whl, w_hl_data, w_info, w_color)
        dwm_hl_fn("M", mhl, m_hl_data, m_info, m_color)

method vline(ts_helper this) =>
    bool t = not na(time("", this.session, gmt_tz))
    bool t_prev = not na(time("", this.session, gmt_tz, bars_back = 1))
    if t and not t_prev
        this.lines.unshift(line.new(bar_index, high * 1.0001, bar_index, low, style = vl_style, width = vl_width, extend = extend.both, color = this.c))
    if not v_unlimited and this.lines.size() > max_days
        this.lines.pop().delete()

vlines() =>
    if tf_ok
        for [_, value] in ts_data
            vline(value)

method hz_line(lines_helper this) =>
    bool t = not na(time("", this.h, gmt_tz))
    bool t_prev = not na(time("", this.h, gmt_tz, bars_back = 1))
    hz_type hz = this._hz
    if t and not t_prev
        hz.LN.unshift(line.new(bar_index, open, bar_index, open, style = hz_style, width = hz_width, color = this.h_color))
        hz.LB.unshift(label.new(bar_index, open, this.h_text, style = label.style_label_left, color = transparent, textcolor = txt_color, size = lbl_size))
        array.unshift(hz.CO, false)
        if not open_unlimited and hz.LN.size() > max_days
            hz.LN.pop().delete()
            hz.LB.pop().delete()
            hz.CO.pop()
    if not t and hz.CO.size() > 0
        if not hz.CO.get(0)
            hz.LN.get(0).set_x2(bar_index)
            hz.LB.get(0).set_x(bar_index)
            if (use_cutoff ? t_co : false)
                hz.CO.set(0, true)

hz_lines() =>
    if tf_ok
        for [_, value] in open_lines
            hz_line(value)

del_kz(kz k) =>
    if k._box.size() > max_days
        k._box.pop().delete()
    if k._hi_line.size() > max_days
        k._hi_line.pop().delete()
        k._lo_line.pop().delete()
        k._hi_valid.pop()
        k._lo_valid.pop()
        if show_midpoints
            k._md_line.pop().delete()
            k._md_valid.pop()
    if k._hi_label.size() > max_days
        k._hi_label.pop().delete()
        k._lo_label.pop().delete()

update_price_string(label L, float P) =>
    S = L.get_text()
    pre = str.substring(S, 0, str.pos(S, " "))
    str.trim(pre)
    L.set_text(str.format("{0} ({1})", pre, P))

adjust_in_kz(kz kzData, bool t) =>
    if t
        kzBox0 = kzData._box.get(0)
        kzBox0.set_right(time)
        newTop = math.max(kzBox0.get_top(), high)
        kzBox0.set_top(newTop)
        newBottom = math.min(kzBox0.get_bottom(), low)
        kzBox0.set_bottom(newBottom)
        kzData._range_current := newTop - newBottom

        if show_pivots and kzData._hi_line.size() > 0
            kzHiLine0 = kzData._hi_line.get(0)
            kzHiLine0.set_x2(time)
            if high > kzHiLine0.get_y1()
                kzHiLine0.set_xy1(time, high)
                kzHiLine0.set_xy2(time, high)
            kzLoLine0 = kzData._lo_line.get(0)
            kzLoLine0.set_x2(time)
            if low < kzLoLine0.get_y1()
                kzLoLine0.set_xy1(time, low)
                kzLoLine0.set_xy2(time, low)
            if show_midpoints
                kzMidLine0 = kzData._md_line.get(0)
                kzMidLine0.set_x2(time)
                kzMidLine0.set_xy1(time, math.avg(kzData._hi_line.get(0).get_y2(), kzData._lo_line.get(0).get_y2()))
                kzMidLine0.set_xy2(time, math.avg(kzData._hi_line.get(0).get_y2(), kzData._lo_line.get(0).get_y2()))

        if show_labels and kzData._hi_label.size() > 0
            if label_right
                kzData._hi_label.get(0).set_x(time)
                kzData._lo_label.get(0).set_x(time)
            if high > kzData._hi_label.get(0).get_y()
                kzData._hi_label.get(0).set_xy(time, high)
                if label_price
                    update_price_string(kzData._hi_label.get(0), high)
            if low < kzData._lo_label.get(0).get_y()
                kzData._lo_label.get(0).set_xy(time, low)
                if label_price
                    update_price_string(kzData._lo_label.get(0), low)

adjust_out_kz(kz kzData, bool t, bool t_prev) =>
    boxCount = kzData._box.size()
    if not t and boxCount > 0
        if t_prev
            array.unshift(kzData._range_store, kzData._range_current)
            if kzData._range_store.size() > range_avg
                kzData._range_store.pop()
    if show_pivots and boxCount > 0
        for i = 0 to boxCount - 1 by 1
            if not ext_current or i == 0
                kzHiValid = kzData._hi_valid.get(i)
                if ext_past or kzHiValid
                    kzData._hi_line.get(i).set_x2(time)
                    if show_labels and label_right
                        kzData._hi_label.get(i).set_x(time)
                if kzHiValid and high > kzData._hi_line.get(i).get_y1()
                    if use_alerts and i == 0
                        alert('Broke ' + kzData._title + ' High', alert.freq_once_per_bar)
                    kzData._hi_valid.set(i, false)
                    if show_labels and label_right
                        kzData._hi_label.get(i).set_style(label.style_label_down)
                else if use_cutoff ? t_co : false
                    kzData._hi_valid.set(i, false)
                kzLoValid = kzData._lo_valid.get(i)
                if ext_past or kzLoValid
                    kzData._lo_line.get(i).set_x2(time)
                    if show_labels and label_right
                        kzData._lo_label.get(i).set_x(time)
                if kzLoValid and low < kzData._lo_line.get(i).get_y1()
                    if use_alerts and i == 0
                        alert("Broke " + kzData._title + " Low", alert.freq_once_per_bar)
                    kzData._lo_valid.set(i, false)
                    if show_labels and label_right
                        kzData._lo_label.get(i).set_style(label.style_label_up)
                else if use_cutoff ? t_co : false
                    kzData._lo_valid.set(i, false)
                if show_midpoints and not t
                    if stop_midpoints ? kzData._md_valid.get(i) : true
                        kzData._md_line.get(i).set_x2(time)
                        if kzData._md_valid.get(i) and low <= kzData._md_line.get(i).get_y1() and high >= kzData._md_line.get(i).get_y1()
                            kzData._md_valid.set(i, false)
            else
                break

method manage_kz(kz_helper this) =>
    kz kzData = this._kz
    c = this.c
    if tf_ok
        t = not na(time("", this.session, gmt_tz))
        t_prev = not na(time("", this.session, gmt_tz, bars_back = 1))
        if t and not t_prev
            _c = get_box_color(c)
            _t = get_text_color(c)
            kzData._box.unshift(box.new(time, high, time, low, xloc = xloc.bar_time, border_color = show_kz ? _c : na, bgcolor = show_kz ? _c : na, text = show_kz and show_kz_text ? this.box_txt : na, text_color = _t))
            if show_pivots
                kzData._hi_line.unshift(line.new(time, high, time, high, xloc = xloc.bar_time, style = kzp_style, color = c, width = kzp_width))
                kzData._lo_line.unshift(line.new(time, low, time, low, xloc = xloc.bar_time, style = kzp_style, color = c, width = kzp_width))
                if show_midpoints
                    kzData._md_line.unshift(line.new(time, math.avg(high, low), time, math.avg(high, low), xloc = xloc.bar_time, style = kzm_style, color = c, width = kzm_width))
                    array.unshift(kzData._md_valid, true)
                array.unshift(kzData._hi_valid, true)
                array.unshift(kzData._lo_valid, true)
                if show_labels
                    _hi_txt = label_price ? str.format('{0} ({1})', this.hi_txt, high) : this.hi_txt
                    _lo_txt = label_price ? str.format('{0} ({1})', this.lo_txt, low) : this.lo_txt
                    if label_right
                        kzData._hi_label.unshift(label.new(time, high, _hi_txt, xloc = xloc.bar_time, color = transparent, textcolor = txt_color, style = label.style_label_left, size = lbl_size))
                        kzData._lo_label.unshift(label.new(time, low, _lo_txt, xloc = xloc.bar_time, color = transparent, textcolor = txt_color, style = label.style_label_left, size = lbl_size))
                    else
                        kzData._hi_label.unshift(label.new(time, high, _hi_txt, xloc = xloc.bar_time, color = transparent, textcolor = txt_color, style = label.style_label_down, size = lbl_size))
                        kzData._lo_label.unshift(label.new(time, low, _lo_txt, xloc = xloc.bar_time, color = transparent, textcolor = txt_color, style = label.style_label_up, size = lbl_size))
            del_kz(kzData)
        adjust_in_kz(kzData, t)
        adjust_out_kz(kzData, t, t_prev)

// --- Execute Killzones ---
if kz_enabled
    for [_, value] in _kz
        manage_kz(value)
    dwm()
    vlines()
    hz_lines()

// --- Day of Week Labels ---
new_dow_time = dow_xloc == 'Midday' ? time - timeframe.in_seconds("D") / 2 * 1000 : time
new_day = dayofweek(new_dow_time, gmt_tz) != dayofweek(new_dow_time, gmt_tz)[1]
var dow_top = dow_yloc == 'Top'

plotchar(kz_enabled and dow_labels and timeframe.isintraday and dayofweek(new_dow_time, gmt_tz) == 1 and new_day and not dow_hide_wknd, location = dow_top ? location.top : location.bottom, char = '', textcolor = txt_color, text = "SUNDAY")
plotchar(kz_enabled and dow_labels and timeframe.isintraday and dayofweek(new_dow_time, gmt_tz) == 2 and new_day, location = dow_top ? location.top : location.bottom, char = '', textcolor = txt_color, text = "MONDAY")
plotchar(kz_enabled and dow_labels and timeframe.isintraday and dayofweek(new_dow_time, gmt_tz) == 3 and new_day, location = dow_top ? location.top : location.bottom, char = '', textcolor = txt_color, text = "TUESDAY")
plotchar(kz_enabled and dow_labels and timeframe.isintraday and dayofweek(new_dow_time, gmt_tz) == 4 and new_day, location = dow_top ? location.top : location.bottom, char = '', textcolor = txt_color, text = "WEDNESDAY")
plotchar(kz_enabled and dow_labels and timeframe.isintraday and dayofweek(new_dow_time, gmt_tz) == 5 and new_day, location = dow_top ? location.top : location.bottom, char = '', textcolor = txt_color, text = "THURSDAY")
plotchar(kz_enabled and dow_labels and timeframe.isintraday and dayofweek(new_dow_time, gmt_tz) == 6 and new_day, location = dow_top ? location.top : location.bottom, char = '', textcolor = txt_color, text = "FRIDAY")
plotchar(kz_enabled and dow_labels and timeframe.isintraday and dayofweek(new_dow_time, gmt_tz) == 7 and new_day and not dow_hide_wknd, location = dow_top ? location.top : location.bottom, char = '', textcolor = txt_color, text = "SATURDAY")

// --- Range Table ---
get_min_days_stored() =>
    store = array.new_int()
    for [_, value] in _kz
        int tmpStoreSize = value._kz._range_store.size()
        if tmpStoreSize > 0
            store.push(tmpStoreSize)
    store.min()

method set_table(table tbl, kz kzData, int row, string txt, bool t, color col) =>
    table.cell(tbl, 0, row, txt, text_size = range_size, bgcolor = get_box_color(col), text_color = txt_color)
    table.cell(tbl, 1, row, str.tostring(kzData._range_current), text_size = range_size, bgcolor = t ? get_box_color(col) : na, text_color = txt_color)
    if show_range_avg
        table.cell(tbl, 2, row, str.tostring(kzData._range_store.avg()), text_size = range_size, text_color = txt_color)

if kz_enabled and show_range and barstate.islast
    var tbl = table.new(range_pos, 10, 10, chart.bg_color, chart.fg_color, 2, chart.fg_color, 1)
    table.cell(tbl, 0, 0, "Killzone", text_size = range_size, text_color = txt_color)
    table.cell(tbl, 1, 0, "Range", text_size = range_size, text_color = txt_color)
    if show_range_avg
        table.cell(tbl, 2, 0, "Avg (" + str.tostring(get_min_days_stored()) + ")", text_size = range_size, text_color = txt_color)
    for [index, value] in _kz
        set_table(tbl, value._kz, index + 1, value.box_txt, not na(time("", value.session, gmt_tz)), value.c)


// ══════════════════════════════════════════════════════════════════════
//  MODULE 2: DAILY / WEEKLY / MONTHLY HIGHS & LOWS (Enhanced)
//  Based on "DWM HL" by sbtnc — with gradient & projection
// ══════════════════════════════════════════════════════════════════════
var g_DWM_HL = "② DWM Highs & Lows (Enhanced)"
dwm_hl_enabled      = input.bool(true, "Enable DWM H/L Module", group = g_DWM_HL)
dwm_daily_on        = input(true, "Daily", inline = "dhl", group = g_DWM_HL)
dwm_daily_color     = input(color.green, "", inline = "dhl", group = g_DWM_HL)
dwm_daily_lookback  = input.int(2, "", 1, inline = "dhl", group = g_DWM_HL)
dwm_weekly_on       = input(true, "Weekly", inline = "whl", group = g_DWM_HL)
dwm_weekly_color    = input(color.orange, "", inline = "whl", group = g_DWM_HL)
dwm_weekly_lookback = input.int(1, "", 1, inline = "whl", group = g_DWM_HL)
dwm_monthly_on      = input(true, "Monthly", inline = "mhl2", group = g_DWM_HL)
dwm_monthly_color   = input(color.red, "", inline = "mhl2", group = g_DWM_HL)
dwm_monthly_lookback = input.int(1, "", 1, inline = "mhl2", group = g_DWM_HL)
dwm_projections     = input(false, "Show Projections", inline = "head", group = g_DWM_HL)
dwm_right_offset    = input.int(20, "", 1, inline = "head", group = g_DWM_HL)
dwm_gradient        = input(true, "Show Gradient", group = g_DWM_HL)

var a_lastHighs = array.new_float(3)
var a_lastLows  = array.new_float(3)
var canShowDwmDaily   = dwm_daily_on and timeframe.isintraday
var canShowDwmWeekly  = dwm_weekly_on and (timeframe.isintraday or timeframe.isdaily)
var canShowDwmMonthly = dwm_monthly_on and not timeframe.ismonthly

[dailyTime2, dailyHigh2, dailyLow2, isLastDaily2]       = request.security(syminfo.tickerid, 'D', [time, high, low, barstate.islast], lookahead = barmerge.lookahead_on)
[weeklyTime2, weeklyHigh2, weeklyLow2, isLastWeekly2]    = request.security(syminfo.tickerid, 'W', [time, high, low, barstate.islast], lookahead = barmerge.lookahead_on)
[monthlyTime2, monthlyHigh2, monthlyLow2, isLastMonthly2] = request.security(syminfo.tickerid, 'M', [time, high, low, barstate.islast], lookahead = barmerge.lookahead_on)

hasDailyTimeChanged2   = dailyTime2 != dailyTime2[1]
hasWeeklyTimeChanged2  = weeklyTime2 != weeklyTime2[1]
hasMonthlyTimeChanged2 = monthlyTime2 != monthlyTime2[1]

f_getRightBarIndex() => bar_index + dwm_right_offset

f_draw_dwm(bool _isNew, float _h, float _l, int _lookback, color _color, string _style, int _width) =>
    var line _high = na
    var line _low  = na
    var _highs = array.new_line()
    var _lows  = array.new_line()
    _end = dwm_projections ? f_getRightBarIndex() : bar_index
    if _isNew
        line.set_x2(_high, _end)
        line.set_x2(_low, _end)
        if dwm_gradient
            _size = array.size(_highs)
            if _size > 1
                for i = 0 to _size - 1
                    _c = color.from_gradient(i, 0, _size - 1, color.new(_color, 100), color.new(_color, 0))
                    line.set_color(array.get(_highs, i), _c)
                    line.set_color(array.get(_lows, i), _c)
        _high := line.new(bar_index, _h, bar_index, _h, color = _color, style = _style == "dashed" ? line.style_dashed : line.style_dashed, width = _width)
        _low  := line.new(bar_index, _l, bar_index, _l, color = _color, style = _style == "dashed" ? line.style_dashed : line.style_dashed, width = _width)
        array.push(_highs, _high)
        array.push(_lows, _low)
        if array.size(_highs) > _lookback + 1
            line.delete(array.shift(_highs))
            line.delete(array.shift(_lows))
    if dwm_projections and barstate.islast and array.size(_highs) > 1
        for i = 0 to array.size(_highs) - 2
            line.set_x2(array.get(_highs, i), f_getRightBarIndex())
            line.set_x2(array.get(_lows, i), f_getRightBarIndex())

if dwm_hl_enabled
    if canShowDwmDaily and hasDailyTimeChanged2 and not isLastDaily2
        array.set(a_lastHighs, 0, dailyHigh2)
        array.set(a_lastLows, 0, dailyLow2)
    if canShowDwmWeekly and hasWeeklyTimeChanged2 and not isLastWeekly2
        array.set(a_lastHighs, 1, weeklyHigh2)
        array.set(a_lastLows, 1, weeklyLow2)
    if canShowDwmMonthly and hasMonthlyTimeChanged2 and not isLastMonthly2
        array.set(a_lastHighs, 2, monthlyHigh2)
        array.set(a_lastLows, 2, monthlyLow2)
    if canShowDwmMonthly
        f_draw_dwm(hasMonthlyTimeChanged2, monthlyHigh2, monthlyLow2, dwm_monthly_lookback, dwm_monthly_color, "dashed", 1)
    if canShowDwmWeekly
        f_draw_dwm(hasWeeklyTimeChanged2, weeklyHigh2, weeklyLow2, dwm_weekly_lookback, dwm_weekly_color, "dashed", 1)
    if canShowDwmDaily
        f_draw_dwm(hasDailyTimeChanged2, dailyHigh2, dailyLow2, dwm_daily_lookback, dwm_daily_color, "dashed", 1)

plot(dwm_hl_enabled ? array.get(a_lastHighs, 0) : na, "DH", color.new(dwm_daily_color, 100), editable = false)
plot(dwm_hl_enabled ? array.get(a_lastLows, 0) : na, "DL", color.new(dwm_daily_color, 100), editable = false)
plot(dwm_hl_enabled ? array.get(a_lastHighs, 1) : na, "WH", color.new(dwm_weekly_color, 100), editable = false)
plot(dwm_hl_enabled ? array.get(a_lastLows, 1) : na, "WL", color.new(dwm_weekly_color, 100), editable = false)
plot(dwm_hl_enabled ? array.get(a_lastHighs, 2) : na, "MH", color.new(dwm_monthly_color, 100), editable = false)
plot(dwm_hl_enabled ? array.get(a_lastLows, 2) : na, "ML", color.new(dwm_monthly_color, 100), editable = false)


// ══════════════════════════════════════════════════════════════════════
//  MODULE 3: MTF EMA + VWAP
//  Multi-Timeframe EMA with buy/sell signals & VWAP
// ══════════════════════════════════════════════════════════════════════
var g_EMA = "③ MTF EMA + VWAP"
ema_enabled     = input.bool(true, "Enable MTF EMA Module", group = g_EMA)
ema_source      = input.source(close, "Source", group = g_EMA)
ema_len1        = input.int(12, "EMA 1 Length", minval = 1, group = g_EMA)
ema_len2        = input.int(26, "EMA 2 Length", minval = 1, group = g_EMA)
ema_len3        = input.int(100, "EMA 3 Length", minval = 1, group = g_EMA)
ema_len4        = input.int(200, "EMA 4 Length", minval = 1, group = g_EMA)

var g_EMA_TF = "③ MTF EMA — Timeframes"
ema_short_tf    = input.timeframe("60", "Short TF", group = g_EMA_TF)
ema_medium_tf   = input.timeframe("240", "Medium TF", group = g_EMA_TF)
ema_long_tf     = input.timeframe("1D", "Long TF", group = g_EMA_TF)
ema_show_htf    = input.bool(true, "Show Higher TF EMAs", group = g_EMA_TF)
ema_show_signals = input.bool(true, "Show Buy/Sell Signals", group = g_EMA_TF)

var g_VWAP = "③ VWAP Settings"
show_vwap       = input.bool(true, "Show VWAP", group = g_VWAP)
vwap_source     = input.source(hlc3, "VWAP Source", group = g_VWAP)
vwap_anchor     = input.string("Session", "VWAP Anchor", options = ["Session", "Week", "Month"], group = g_VWAP)

// --- Current TF EMAs ---
ema_ctf_1 = ta.ema(ema_source, ema_len1)
ema_ctf_2 = ta.ema(ema_source, ema_len2)
ema_ctf_3 = ta.ema(ema_source, ema_len3)
ema_ctf_4 = ta.ema(ema_source, ema_len4)

// --- Higher TF EMAs (auto-detect) ---
var string ema_htf = ""
if timeframe.isminutes and timeframe.multiplier < 5
    ema_htf := "5"
else if (timeframe.isminutes and timeframe.multiplier >= 5) or timeframe.isdaily
    ema_htf := "D"
else if timeframe.isweekly
    ema_htf := "W"
else if timeframe.ismonthly
    ema_htf := "M"

ema_htf_1 = request.security(syminfo.tickerid, ema_htf, ta.ema(ema_source, ema_len1))
ema_htf_2 = request.security(syminfo.tickerid, ema_htf, ta.ema(ema_source, ema_len2))
ema_htf_3 = request.security(syminfo.tickerid, ema_htf, ta.ema(ema_source, ema_len3))
ema_htf_4 = request.security(syminfo.tickerid, ema_htf, ta.ema(ema_source, ema_len4))

// --- MTF EMAs for signals (Short / Medium / Long TF) ---
ema_short  = request.security(syminfo.tickerid, ema_short_tf, ta.ema(ema_source, ema_len1))
ema_medium = request.security(syminfo.tickerid, ema_medium_tf, ta.ema(ema_source, ema_len2))
ema_long   = request.security(syminfo.tickerid, ema_long_tf, ta.ema(ema_source, ema_len3))

// --- Buy/Sell Conditions ---
buy_cond  = (ema_short > ema_long and ema_medium > ema_long)
sell_cond = (ema_short < ema_long and ema_medium < ema_long)
buy_signal  = buy_cond and not buy_cond[1]
sell_signal = sell_cond and not sell_cond[1]

// --- Plot CTF EMAs ---
plot(ema_enabled ? ema_ctf_1 : na, "EMA 1 CTF", color.red, 1)
plot(ema_enabled ? ema_ctf_2 : na, "EMA 2 CTF", color.green, 1)
plot(ema_enabled ? ema_ctf_3 : na, "EMA 3 CTF", color.orange, 1)
plot(ema_enabled ? ema_ctf_4 : na, "EMA 4 CTF", color.yellow, 1)

// --- Plot HTF EMAs ---
plot(ema_enabled and ema_show_htf ? ema_htf_1 : na, "EMA 1 HTF", color.red, 2)
plot(ema_enabled and ema_show_htf ? ema_htf_2 : na, "EMA 2 HTF", color.green, 2)
plot(ema_enabled and ema_show_htf ? ema_htf_3 : na, "EMA 3 HTF", color.orange, 2)
plot(ema_enabled and ema_show_htf ? ema_htf_4 : na, "EMA 4 HTF", color.yellow, 2)

// --- Plot MTF Signal EMAs ---
plot(ema_enabled ? ema_short : na, "Short TF EMA", color.rgb(0, 230, 118), 1)
plot(ema_enabled ? ema_medium : na, "Medium TF EMA", color.rgb(224, 64, 251), 2)
plot(ema_enabled ? ema_long : na, "Long TF EMA", color.rgb(255, 235, 59), 3)

// --- Buy/Sell Signals ---
plotchar(ema_enabled and ema_show_signals and buy_signal, title = "Buy", char = "▲", location = location.belowbar, color = color.rgb(0, 230, 118), size = size.small)
plotchar(ema_enabled and ema_show_signals and sell_signal, title = "Sell", char = "▼", location = location.abovebar, color = color.rgb(255, 82, 82), size = size.small)

// --- VWAP ---
is_newbar_vwap = switch vwap_anchor
    "Session" => timeframe.change("D")
    "Week"    => timeframe.change("W")
    "Month"   => timeframe.change("M")

var float vwap_sum    = 0.0
var float volume_sum2 = 0.0

if is_newbar_vwap
    vwap_sum    := 0.0
    volume_sum2 := 0.0

vwap_sum    += vwap_source * volume
volume_sum2 += volume
vwap_val = volume_sum2 != 0 ? vwap_sum / volume_sum2 : na

plot(ema_enabled and show_vwap ? vwap_val : na, "VWAP", color.blue, 2)

// --- EMA Alerts ---
if ema_enabled and buy_signal
    alert("MTF EMA Buy Signal\nClose: " + str.tostring(close), alert.freq_once_per_bar_close)
if ema_enabled and sell_signal
    alert("MTF EMA Sell Signal\nClose: " + str.tostring(close), alert.freq_once_per_bar_close)


// ══════════════════════════════════════════════════════════════════════
//  MODULE 4: ICT HTF CANDLES
//  Higher Timeframe Candles with FVG & Volume Imbalance
// ══════════════════════════════════════════════════════════════════════
var g_HTFC = "④ HTF Candles"
htfc_enabled = input.bool(true, "Enable HTF Candles Module", group = g_HTFC)

type HTFCandle
    float o
    float c
    float h
    float l
    int o_idx
    box body
    line wick_up
    line wick_down

type HTFCandleSet
    array<HTFCandle> candles
    string htf
    bool show
    int max_display

var g_HTFC_TF = "④ HTF Candles — Timeframes"
htfc1_show = input.bool(true, 'HTF 1', inline = 'htfc1', group = g_HTFC_TF)
htfc1_tf   = input.timeframe('15', '', inline = 'htfc1', group = g_HTFC_TF)
htfc1_max  = input.int(10, '', inline = 'htfc1', group = g_HTFC_TF)

htfc2_show = input.bool(true, 'HTF 2', inline = 'htfc2', group = g_HTFC_TF)
htfc2_tf   = input.timeframe('60', '', inline = 'htfc2', group = g_HTFC_TF)
htfc2_max  = input.int(10, '', inline = 'htfc2', group = g_HTFC_TF)

htfc3_show = input.bool(true, 'HTF 3', inline = 'htfc3', group = g_HTFC_TF)
htfc3_tf   = input.timeframe('240', '', inline = 'htfc3', group = g_HTFC_TF)
htfc3_max  = input.int(10, '', inline = 'htfc3', group = g_HTFC_TF)

htfc4_show = input.bool(false, 'HTF 4', inline = 'htfc4', group = g_HTFC_TF)
htfc4_tf   = input.timeframe('1D', '', inline = 'htfc4', group = g_HTFC_TF)
htfc4_max  = input.int(10, '', inline = 'htfc4', group = g_HTFC_TF)

var g_HTFC_STYLE = "④ HTF Candles — Style"
htfc_bull_body   = input.color(color.new(color.green, 10), 'Bull Body', inline = 'htfc_body', group = g_HTFC_STYLE)
htfc_bear_body   = input.color(color.new(color.red, 10), 'Bear Body', inline = 'htfc_body', group = g_HTFC_STYLE)
htfc_bull_border = input.color(color.new(color.black, 10), 'Bull Border', inline = 'htfc_bord', group = g_HTFC_STYLE)
htfc_bear_border = input.color(color.new(color.black, 10), 'Bear Border', inline = 'htfc_bord', group = g_HTFC_STYLE)
htfc_bull_wick   = input.color(color.new(color.black, 10), 'Bull Wick', inline = 'htfc_wick', group = g_HTFC_STYLE)
htfc_bear_wick   = input.color(color.new(color.black, 10), 'Bear Wick', inline = 'htfc_wick', group = g_HTFC_STYLE)
htfc_offset      = input.int(10, 'Padding', minval = 1, group = g_HTFC_STYLE)
htfc_buffer      = input.int(1, 'Spacing', minval = 1, maxval = 4, group = g_HTFC_STYLE)
htfc_htf_buffer  = input.int(10, 'HTF Spacing', minval = 1, maxval = 10, group = g_HTFC_STYLE)
htfc_candle_width = input.int(1, 'Candle Width', minval = 1, maxval = 4, group = g_HTFC_STYLE) * 2

htfc_fvg_show    = input.bool(true, 'Fair Value Gap', inline = 'htfc_fvg', group = g_HTFC_STYLE)
htfc_fvg_color   = input.color(color.new(color.gray, 80), '', inline = 'htfc_fvg', group = g_HTFC_STYLE)

// --- HTF Candle Sets ---
var array<HTFCandle> htfc_candles_1 = array.new<HTFCandle>(0)
var array<HTFCandle> htfc_candles_2 = array.new<HTFCandle>(0)
var array<HTFCandle> htfc_candles_3 = array.new<HTFCandle>(0)
var array<HTFCandle> htfc_candles_4 = array.new<HTFCandle>(0)

htfc_valid_tf(string HTF) =>
    if timeframe.in_seconds(HTF) >= timeframe.in_seconds('D') and timeframe.in_seconds(HTF) > timeframe.in_seconds()
        true
    else
        n1 = timeframe.in_seconds()
        n2 = timeframe.in_seconds(HTF)
        n1 < n2 and math.round(n2 / n1) == n2 / n1

htfc_monitor(array<HTFCandle> candles, string htf_tf, int max_disp) =>
    HTFBarTime = time(htf_tf)
    isNew = ta.change(HTFBarTime) > 0
    if isNew
        HTFCandle c = HTFCandle.new()
        c.o := open
        c.c := close
        c.h := high
        c.l := low
        c.o_idx := bar_index
        bull = c.c > c.o
        c.body := box.new(bar_index, math.max(c.o, c.c), bar_index + 2, math.min(c.o, c.c), bull ? htfc_bull_border : htfc_bear_border, 1, bgcolor = bull ? htfc_bull_body : htfc_bear_body)
        c.wick_up := line.new(bar_index + 1, c.h, bar_index, math.max(c.o, c.c), color = bull ? htfc_bull_wick : htfc_bear_wick)
        c.wick_down := line.new(bar_index + 1, math.min(c.o, c.c), bar_index, c.l, color = bull ? htfc_bull_wick : htfc_bear_wick)
        candles.unshift(c)
        if candles.size() > max_disp
            HTFCandle del = array.pop(candles)
            box.delete(del.body)
            line.delete(del.wick_up)
            line.delete(del.wick_down)

htfc_update(array<HTFCandle> candles, int offset_val) =>
    if candles.size() > 0
        HTFCandle c = candles.first()
        c.h := high > c.h ? high : c.h
        c.l := low < c.l ? low : c.l
        c.c := close
        bull = c.c > c.o
        box.set_top(c.body, math.max(c.o, c.c))
        box.set_bottom(c.body, math.min(c.o, c.c))
        box.set_bgcolor(c.body, bull ? htfc_bull_body : htfc_bear_body)
        box.set_border_color(c.body, bull ? htfc_bull_border : htfc_bear_border)
        line.set_color(c.wick_up, bull ? htfc_bull_wick : htfc_bear_wick)
        line.set_color(c.wick_down, bull ? htfc_bull_wick : htfc_bear_wick)
        line.set_y1(c.wick_up, c.h)
        line.set_y2(c.wick_up, math.max(c.o, c.c))
        line.set_y1(c.wick_down, c.l)
        line.set_y2(c.wick_down, math.min(c.o, c.c))

        if barstate.isrealtime or barstate.islast
            sz = candles.size()
            if sz > 0
                for i = sz - 1 to 0 by 1
                    HTFCandle candle = candles.get(i)
                    t_buf = offset_val + (htfc_candle_width + htfc_buffer) * (sz - i - 1)
                    box.set_left(candle.body, bar_index + t_buf)
                    box.set_right(candle.body, bar_index + htfc_candle_width + t_buf)
                    line.set_x1(candle.wick_up, bar_index + htfc_candle_width / 2 + t_buf)
                    line.set_x2(candle.wick_up, bar_index + htfc_candle_width / 2 + t_buf)
                    line.set_x1(candle.wick_down, bar_index + htfc_candle_width / 2 + t_buf)
                    line.set_x2(candle.wick_down, bar_index + htfc_candle_width / 2 + t_buf)
    candles.size()

htfc_find_fvg(array<HTFCandle> candles) =>
    if htfc_fvg_show and candles.size() > 2
        for i = 0 to candles.size() - 3 by 1
            c1 = candles.get(i)
            c2 = candles.get(i + 2)
            if c1.l > c2.h and math.min(c1.o, c1.c) > math.max(c2.o, c2.c)
                box.new(box.get_left(c2.body), c2.h, box.get_right(c1.body), c1.l, bgcolor = htfc_fvg_color, border_color = transparent)
            if c1.h < c2.l and math.max(c1.o, c1.c) < math.min(c2.o, c2.c)
                box.new(box.get_right(c1.body), c1.h, box.get_left(c2.body), c2.l, bgcolor = htfc_fvg_color, border_color = transparent)

// --- Execute HTF Candles ---
if htfc_enabled
    int htfc_off = htfc_offset
    if htfc1_show and htfc_valid_tf(htfc1_tf)
        htfc_monitor(htfc_candles_1, htfc1_tf, htfc1_max)
        int sz1 = htfc_update(htfc_candles_1, htfc_off)
        htfc_off := htfc_off + (sz1 > 0 ? sz1 * htfc_candle_width + (sz1 - 1) * htfc_buffer + htfc_htf_buffer : 0)
    if htfc2_show and htfc_valid_tf(htfc2_tf)
        htfc_monitor(htfc_candles_2, htfc2_tf, htfc2_max)
        int sz2 = htfc_update(htfc_candles_2, htfc_off)
        htfc_off := htfc_off + (sz2 > 0 ? sz2 * htfc_candle_width + (sz2 - 1) * htfc_buffer + htfc_htf_buffer : 0)
    if htfc3_show and htfc_valid_tf(htfc3_tf)
        htfc_monitor(htfc_candles_3, htfc3_tf, htfc3_max)
        int sz3 = htfc_update(htfc_candles_3, htfc_off)
        htfc_off := htfc_off + (sz3 > 0 ? sz3 * htfc_candle_width + (sz3 - 1) * htfc_buffer + htfc_htf_buffer : 0)
    if htfc4_show and htfc_valid_tf(htfc4_tf)
        htfc_monitor(htfc_candles_4, htfc4_tf, htfc4_max)
        htfc_update(htfc_candles_4, htfc_off)
