nal_str         = input.string("NYAM.L", "", inline = "L_NA", group = g_KZP)
nlh_str         = input.string("NYL.H", "KZ 4 Labels", inline = "L_NL", group = g_KZP)
nll_str         = input.string("NYL.L", "", inline = "L_NL", group = g_KZP)
nph_str         = input.string("NYPM.H", "KZ 5 Labels", inline = "L_NP", group = g_KZP)
npl_str         = input.string("NYPM.L", "", inline = "L_NP", group = g_KZP)

kzp_style       = get_line_type(input.string('Solid', "Pivot Style", options = ['Solid', 'Dotted', 'Dashed'], inline = "KZP", group = g_KZP))
kzp_width       = input.int(1, "", inline = "KZP", group = g_KZP)
kzm_style       = get_line_type(input.string('Dotted', "Midpoint Style", options = ['Solid', 'Dotted', 'Dashed'], inline = "KZM", group = g_KZP))
